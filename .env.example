PORT=3000
# Database access is disabled by default in the prototype.
DATABASE_ENABLED=false

# Fill these values only when a future local or cloud database is explicitly enabled.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=srmm_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false
# DATABASE_URL=

# Frontend URL usada para construir el enlace de recuperación
FRONTEND_URL=http://localhost:3000

# SMTP (Gmail recomendado con App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Kafka local
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_UI_BOOTSTRAP_SERVERS=kafka1:29092,kafka2:29092,kafka3:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# Kafka Admin API (complete tenant and audience before enabling Azure auth)
AZURE_TENANT_ID=
AZURE_API_AUDIENCE=
AZURE_REQUIRED_SCOPE=access_as_user
AZURE_AUTH_ENABLED=false

# Kafka Bridge
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=srmm
RABBITMQ_PASSWORD=
RABBITMQ_PREFETCH=10
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_RETRIES=10
KAFKA_PRODUCER_LINGER_MS=5
KAFKA_PRODUCER_COMPRESSION_TYPE=lz4

# Kafka Analitica consumers
KAFKA_TOPIC_OPERATIONAL_EVENTS=srmm.eventos-operacionales
KAFKA_TOPIC_MACHINERY_STATE=srmm.estado-maquinaria
KAFKA_TOPIC_OPERATIONAL_DLT=srmm.eventos-operacionales.DLT
KAFKA_TOPIC_MACHINERY_STATE_DLT=srmm.estado-maquinaria.DLT
KAFKA_ANALITICA_GROUP_ID=analitica-group
KAFKA_AUDITORIA_GROUP_ID=auditoria-group
KAFKA_DLT_GROUP_ID=analitica-dlt-group
KAFKA_ANALITICA_CONCURRENCY=3
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_RECORDS=500
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_TRUSTED_PACKAGES=cl.srmm.kafka.bridge.messaging.dto
ANALITICA_WINDOW_DURATION=PT5M
