PORT=3000
# Database access is disabled by default in the prototype.
DATABASE_ENABLED=false

# Fill these values only when a future local or cloud database is explicitly enabled.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=srmm_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false
