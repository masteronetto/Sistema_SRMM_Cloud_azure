# Desarrollo local. Para CloudFront, usar la URL HTTPS del HTTP API Gateway.
VITE_API_BASE_URL=http://localhost:3001/api
# VITE_API_BASE_URL=https://<API_ID>.execute-api.<AWS_REGION>.amazonaws.com/api
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
# Formato esperado: api://<BFF_APPLICATION_ID_URI>/access_as_user
VITE_AZURE_API_SCOPE=
# Mantener localhost y agregar la URL de CloudFront como redirect URI SPA en Entra.
VITE_AZURE_REDIRECT_URI=http://localhost:5173
