{
  "name": "sistema-srmm",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicacion SRMM con frontend React/Vite y BFF Express",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "test": "npm --prefix backend test",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:connect": "docker compose exec postgres psql -U postgres -d srmm_cloud",
    "db:status": "docker-compose ps"
  }
}
