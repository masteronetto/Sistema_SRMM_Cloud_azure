# AWS
AWS_REGION=<AWS_REGION>
FRONTEND_BUCKET=<PRIVATE_S3_BUCKET_NAME>
CLOUDFRONT_DISTRIBUTION_ID=<CLOUDFRONT_DISTRIBUTION_ID>
CLOUDFRONT_DOMAIN=<CLOUDFRONT_DOMAIN>

# HTTP API Gateway
API_NAME=srmm-http-api
API_ORIGIN_URL=http://<DUCKDNS_HOST>:3001
API_STAGE_NAME=$default
API_GATEWAY_BASE_URL=<API_ID>.execute-api.<AWS_REGION>.amazonaws.com

# Microsoft Entra ID: obtain exact values from a real access token.
AZURE_JWT_ISSUER=<TOKEN_ISSUER_ISS>
AZURE_JWT_AUDIENCE=<TOKEN_AUDIENCE_AUD>
AZURE_REQUIRED_SCOPE=access_as_user

# Local frontend values are kept in frontend/.env.example.
